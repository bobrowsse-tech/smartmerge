{
  "name": "@smartmerge/core",
  "version": "0.0.0",
  "private": true,
  "description": "Merge pipeline. Recommends deterministic and structural resolutions for TypeScript, JavaScript, JSON, YAML, Python, Go, Java, Kotlin, C#, Rust, C, C++, PHP, Ruby, Swift, SQL, TOML, XML, and Markdown.",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepublishOnly": "tsx ../../tools/assert-git-publish.ts"
  },
  "dependencies": {
    "@binclusive/tree-sitter-swift-wasm": "0.1.0",
    "@cursorless/tree-sitter-wasms": "0.10.0",
    "@l1xnan/tree-sitter-sql": "0.4.7",
    "@smartmerge/protocol": "workspace:*",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@tree-sitter-grammars/tree-sitter-toml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "eslint": "^10.11.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "^6.0.3",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0"
  }
}
