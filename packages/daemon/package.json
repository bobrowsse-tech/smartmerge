{
  "name": "@smartmerge/daemon",
  "version": "0.0.0",
  "description": "JSON-RPC daemon for conflict listing, structural proposals, and undoable apply.",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "smartmerged": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepublishOnly": "tsx ../../tools/assert-git-publish.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0"
  },
  "dependencies": {
    "@smartmerge/core": "workspace:*",
    "@smartmerge/git": "workspace:*",
    "@smartmerge/protocol": "workspace:*",
    "vscode-jsonrpc": "^9.0.3"
  }
}
