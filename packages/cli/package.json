{
  "name": "smart-merge-resolver",
  "version": "0.0.0",
  "description": "SmartMergeResolver command. Installed from npm as smart-merge-resolver; the command is smart-merge.",
  "author": "Bob Rowsse Walakira <hello@bobrowsse.com>",
  "homepage": "https://bobrowsse.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobrowsse-tech/smartmerge.git"
  },
  "bugs": {
    "url": "https://github.com/bobrowsse-tech/smartmerge/issues",
    "email": "hello@bobrowsse.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "smart-merge": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -b && tsx bundle.ts",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepublishOnly": "tsx ../../tools/assert-git-publish.ts"
  },
  "devDependencies": {
    "@smartmerge/agent-kit": "workspace:*",
    "@smartmerge/core": "workspace:*",
    "@smartmerge/daemon": "workspace:*",
    "@smartmerge/git": "workspace:*",
    "@smartmerge/mcp": "workspace:*",
    "@smartmerge/protocol": "workspace:*",
    "@smartmerge/ui": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "4.0.0"
  },
  "dependencies": {
    "eslint": "^10.11.0",
    "ink": "7.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^6.0.3"
  }
}
