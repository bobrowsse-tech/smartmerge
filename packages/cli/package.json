{
  "name": "@smartmerge/cli",
  "version": "0.0.0",
  "private": true,
  "description": "smart-merge command. Status talks to the daemon over stdio.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "smart-merge": "./dist/main.js"
  },
  "main": "./dist/main.js",
