{
  "name": "smart-merge-resolver",
  "version": "0.0.0",
  "private": true,
  "description": "SmartMergeResolver command. Installed from npm as smart-merge-resolver; the command is smart-merge.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "smart-merge": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepublishOnly": "tsx ../../tools/assert-git-publish.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ink-testing-library": "4.0.0"
  },
  "dependencies": {
    "@smartmerge/daemon": "workspace:*",
    "@smartmerge/protocol": "workspace:*",
    "@smartmerge/ui": "workspace:*",
    "ink": "7.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
