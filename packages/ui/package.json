  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0"
  }
