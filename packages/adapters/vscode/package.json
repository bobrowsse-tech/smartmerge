{
  "name": "@smartmerge/vscode",
  "version": "0.0.0",
  "private": true,
  "description": "Editor adapter for SmartMergeResolver. It renders the shared panel and forwards actions to the daemon.",
  "license": "Apache-2.0",
  "publisher": "bobrowsse-tech",
  "author": "Bob Rowsse Walakira <hello@bobrowsse.com>",
  "displayName": "SmartMergeResolver",
  "homepage": "https://bobrowsse.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobrowsse-tech/smartmerge.git"
  },
  "bugs": {
    "url": "https://github.com/bobrowsse-tech/smartmerge/issues",
    "email": "hello@bobrowsse.com"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "smartmerge.refresh",
        "title": "Refresh conflicts"
      },
      {
        "command": "smartmerge.openPanel",
        "title": "Open the merge panel"
      },
      {
        "command": "smartmerge.openDashboard",
        "title": "Open the merge dashboard"
      },
      {
        "command": "smartmerge.acceptFile",
        "title": "Accept the recommended resolution"
      },
      {
        "command": "smartmerge.undo",
        "title": "Undo the last resolution"
      },
      {
        "command": "smartmerge.explain",
        "title": "Explain the recommendation"
      },
      {
        "command": "smartmerge.nextConflict",
        "title": "Show the next conflict"
      },
      {
        "command": "smartmerge.previousConflict",
        "title": "Show the previous conflict"
      },
      {
        "command": "smartmerge.currentConflict",
        "title": "Show the selected conflict"
      }
    ],
    "keybindings": [
      {
        "command": "smartmerge.acceptFile",
        "key": "alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "smartmerge.explain",
        "key": "alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "smartmerge.nextConflict",
        "key": "alt+n",
        "when": "editorTextFocus"
      },
      {
        "command": "smartmerge.previousConflict",
        "key": "alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node dist/esbuild.js",
    "test": "vitest run --config ../../../vitest.config.ts",
    "test:host": "pnpm run build && node dist/pack.js && node dist/host/run.js",
    "pack:vsix": "pnpm run build && node dist/pack.js --vsix"
  },
  "dependencies": {
    "@smartmerge/daemon": "workspace:*",
    "@smartmerge/protocol": "workspace:*",
    "@smartmerge/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/vscode": "1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0"
  }
}
