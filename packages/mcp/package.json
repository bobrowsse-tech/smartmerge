{
  "name": "@smartmerge/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that exposes SmartMergeResolver to coding agents. Writes follow agent policy.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepublishOnly": "tsx ../../tools/assert-git-publish.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@smartmerge/core": "workspace:*",
    "@smartmerge/daemon": "workspace:*",
    "@smartmerge/git": "workspace:*",
    "@smartmerge/protocol": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0"
  }
}
